{
  "name": "games-lobby",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "VITE_HTTPS=1 vite --host --port 4000",
    "host": "vite preview --host --port 3000",
    "build": "vue-tsc --noEmit && vite build && node scripts/generate-route-html.mjs",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "analyze": "node scripts/analyze-assets.mjs",
    "capture": "node scripts/capture.mjs",
    "check:assets": "node scripts/analyze-assets.mjs --check --glb-only",
    "size": "size-limit",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "lint:staged": "eslint --fix",
    "format": "prettier --write src/ packages/",
    "format:check": "prettier --check src/ packages/",
    "prepare": "husky",
    "webp": "node ./scripts/optimize.js",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lighthouse:prod": "node scripts/lighthouse.mjs https://games.cnotv.xyz/",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "lint-staged": {
    "*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{vue,scss,css}": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@strudel/codemirror": "1.3.0",
    "@strudel/core": "1.2.6",
    "@strudel/draw": "1.2.6",
    "@strudel/midi": "1.3.0",
    "@strudel/mini": "1.2.6",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "@tonaljs/tonal": "4.10.0",
    "@tonejs/midi": "^2.0.28",
    "@webgamekit/animation": "^0.1.0",
    "@webgamekit/audio": "^0.1.0",
    "@webgamekit/canvas-editor": "^0.1.0",
    "@webgamekit/chat": "^0.1.0",
    "@webgamekit/controls": "^0.1.0",
    "@webgamekit/dictionary": "^0.1.0",
    "@webgamekit/history": "^0.1.0",
    "@webgamekit/logic": "^0.1.0",
    "@webgamekit/multiplayer-p2p": "^0.1.1",
    "@webgamekit/strudel-flow": "workspace:*",
    "@webgamekit/threejs": "^0.1.0",
    "pinia": "^2.3.0",
    "playwright": "^1.58.0",
    "three": "^0.178.0",
    "trystero": "^0.23.0",
    "vite-plugin-wasm": "^3.3.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@eslint/js": "^9.39.2",
    "@lhci/cli": "^0.15.1",
    "@sentry/vue": "^10.29.0",
    "@size-limit/file": "^12.1.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.11.28",
    "@types/three": "^0.179.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.24",
    "clsx": "^2.1.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^9.0.2",
    "eslint-plugin-jsdoc": "^62.8.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-vue": "^9.17.0",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.2.7",
    "lucide-vue-next": "^0.563.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.3",
    "radix-vue": "^1.9.17",
    "sass": "^1.97.3",
    "sharp": "^0.34.5",
    "size-limit": "^12.1.0",
    "stylelint": "^17.12.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.4.0",
    "vite": "^5.1.6",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.0.6"
  },
  "pnpm": {
    "patchedDependencies": {
      "superdough@1.3.0": "patches/superdough@1.3.0.patch"
    }
  }
}
